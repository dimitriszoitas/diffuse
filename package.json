{
  "name": "diffuse-live-comparison",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "description": "A local-first Chrome extension for live prototype-to-production review.",
  "scripts": {
    "demo": "node scripts/serve-demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:audit-browser": "node tests/audit-browser.mjs",
    "test:accessibility": "node tests/accessibility-overlay.mjs",
    "test:popup": "node tests/popup-browser.mjs",
    "test:sidepanel": "node tests/sidepanel-browser.mjs",
    "test:journey": "node tests/journey-browser.mjs",
    "test:managed-agents": "node tests/managed-agents-browser.mjs",
    "test:review-agent": "node tests/review-agent-browser.mjs",
    "browser:local": "npm --prefix local-browser start",
    "test:local-browser": "npm --prefix local-browser test",
    "test:interactive-audit": "node tests/interactive-audit-browser.mjs",
    "test:journey-executor": "node tests/journey-executor-browser.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {"playwright": "1.62.1"}
}
